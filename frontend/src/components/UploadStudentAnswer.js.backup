import React, { useState, useRef } from 'react';
import axiosInstance from '../api/axiosInstance';
import BatchUploadAnswers from './BatchUploadAnswers';

const UploadStudentAnswer = () => {
  const [uploadType, setUploadType] = useState('single'); // 'single' | 'batch'
  const [studentAnswer, setStudentAnswer] = useState('');
  const [studentName, setStudentName] = useState('Student');
  const [uploadFile, setUploadFile] = useState(null);
  const [modelAnswer, setModelAnswer] = useState('');
  const [question, setQuestion] = useState('');
  const [message, setMessage] = useState('');
  const [isError, setIsError] = useState(false);
  const [loading, setLoading] = useState(false);
  const [evaluation, setEvaluation] = useState(null);
  const [extractedText, setExtractedText] = useState('');
  const [showExtractedText, setShowExtractedText] = useState(false);
  const fileInputRef = useRef(null);

  // Detect if file is image or PDF
  const isImageOrPDF = (file) => {
    const imageTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/bmp'];
    const pdfType = 'application/pdf';
    return imageTypes.includes(file.type) || file.type === pdfType;
  };

  // Extract text using OCR if file is image/PDF
  const extractTextFromFile = async (file) => {
    const formData = new FormData();
    formData.append('file', file);

    try {
      setMessage('🔄 Extracting text from image/PDF...');
      // axiosInstance baseURL is /api, so path is /ocr/extract → /api/ocr/extract
      const response = await axiosInstance.post('/ocr/extract', formData);
      
      const extracted = response.data.extractedText || response.data.text || '';
      setExtractedText(extracted);
      setShowExtractedText(true);
      setStudentAnswer(extracted); // Pre-fill text area with extracted text for editing
      return extracted;
    } catch (err) {
      setMessage(`OCR extraction failed: ${err?.response?.data?.error || err.message}`);
      setIsError(true);
      return null;
    }
  };

  // Evaluate the answer with model
  const evaluateAnswer = async (answerText, isLoading = true) => {
    if (!answerText || !answerText.trim()) {
      setMessage('Please provide or extract student answer text.');
      setIsError(true);
      if (isLoading) setLoading(false);
      return;
    }

    if (!modelAnswer || !modelAnswer.trim()) {
      setMessage('Please provide the model answer.');
      setIsError(true);
      if (isLoading) setLoading(false);
      return;
    }

    try {
      if (isLoading) setMessage('⚖️ Evaluating answer...');

      const response = await axiosInstance.post('/evaluate/text', {
        studentAnswer: answerText,
        modelAnswer: modelAnswer,
        question: question || 'General Question',
      });

      setEvaluation(response.data);
      setMessage('✅ Evaluation completed!');
      setIsError(false);
    } catch (err) {
      setMessage(`Evaluation failed: ${err?.response?.data?.error || err.message}`);
      setIsError(true);
      setEvaluation(null);
    } finally {
      if (isLoading) setLoading(false);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setMessage('');
    setIsError(false);
    setLoading(true);
    setEvaluation(null);
    setShowExtractedText(false);

    try {
      let textToEvaluate = '';

      // Check if user uploaded a file
      if (uploadFile) {
        // File uploaded - could be image/PDF or should be text
        if (isImageOrPDF(uploadFile)) {
          // Extract text from image/PDF using OCR
          setMessage('🔄 Extracting text from image/PDF...');
          textToEvaluate = await extractTextFromFile(uploadFile);
          if (!textToEvaluate) {
            setLoading(false);
            return; // Error message already set
          }
        } else {
          setMessage('Invalid file type. Please upload an image (JPG, PNG, GIF, BMP) or PDF.');
          setIsError(true);
          setLoading(false);
          return;
        }
      } else if (studentAnswer.trim()) {
        // Text entered directly
        textToEvaluate = studentAnswer;
        setMessage('✅ Text detected. Proceeding to evaluation...');
      } else {
        setMessage('Please enter or upload the student answer.');
        setIsError(true);
        setLoading(false);
        return;
      }

      // Validate model answer
      if (!modelAnswer.trim()) {
        setMessage('Please provide the model answer.');
        setIsError(true);
        setLoading(false);
        return;
      }

      // Evaluate the text (pass false to prevent double loading state)
      try {
        setMessage('⚖️ Evaluating answer...');

        const response = await axiosInstance.post('/evaluate/text', {
          studentAnswer: textToEvaluate,
          modelAnswer: modelAnswer,
          question: question || 'General Question',
        });

        setEvaluation(response.data);
        setMessage('✅ Evaluation completed!');
        setIsError(false);
      } catch (err) {
        setMessage(`Evaluation failed: ${err?.response?.data?.error || err.message}`);
        setIsError(true);
        setEvaluation(null);
      }

      // Store answer to backend for future reference
      await axiosInstance.post('/upload-student-answer', {
        studentAnswer: textToEvaluate,
        studentName: studentName || 'Student',
        wasExtractedFromOCR: !!extractedText,
      });

    } catch (err) {
      setMessage(err?.response?.data?.error || 'Process failed.');
      setIsError(true);
    } finally {
      setLoading(false);
    }
  };

  const onFileChange = (e) => {
    const f = e.target.files?.[0];
    if (f) {
      if (isImageOrPDF(f)) {
        setUploadFile(f);
        setStudentAnswer(''); // Clear text if file selected
        setMessage('');
        setIsError(false);
      } else {
        setUploadFile(null);
        setMessage('Invalid file type. Please upload JPG, PNG, GIF, BMP, or PDF.');
        setIsError(true);
        if (fileInputRef.current) fileInputRef.current.value = '';
      }
    } else {
      setUploadFile(null);
    }
  };

  const handleTextChange = (e) => {
    setStudentAnswer(e.target.value);
    if (uploadFile) {
      setUploadFile(null); // Clear file if text entered
      if (fileInputRef.current) fileInputRef.current.value = '';
    }
  };

  const resetForm = () => {
    setMessage('');
    setIsError(false);
    setStudentAnswer('');
    setUploadFile(null);
    setExtractedText('');
    setShowExtractedText(false);
    setEvaluation(null);
    if (fileInputRef.current) fileInputRef.current.value = '';
  };

  return (
    <div className="page">
      <h1>Upload Student Answers</h1>
      <p className="page-desc">
        Choose between uploading a single answer or batch uploading multiple answers.
      </p>

      {/* Upload Type Tabs */}
      <div className="upload-mode-tabs" style={{ marginBottom: '24px' }}>
        <button 
          type="button" 
          className={uploadType === 'single' ? 'tab active' : 'tab'} 
          onClick={() => setUploadType('single')}
          style={{
            flex: 1,
            padding: '12px 16px',
            border: 'none',
            borderRadius: uploadType === 'single' ? '6px 0 0 6px' : '0',
            backgroundColor: uploadType === 'single' ? '#185a9d' : '#e0e0e0',
            color: uploadType === 'single' ? 'white' : '#333',
            cursor: 'pointer',
            fontWeight: 600,
            transition: 'all 0.3s ease'
          }}
        >
          📝 Single Upload
        </button>
        <button 
          type="button" 
          className={uploadType === 'batch' ? 'tab active' : 'tab'} 
          onClick={() => setUploadType('batch')}
          style={{
            flex: 1,
            padding: '12px 16px',
            border: 'none',
            borderRadius: uploadType === 'batch' ? '0 6px 6px 0' : '0',
            backgroundColor: uploadType === 'batch' ? '#185a9d' : '#e0e0e0',
            color: uploadType === 'batch' ? 'white' : '#333',
            cursor: 'pointer',
            fontWeight: 600,
            transition: 'all 0.3s ease'
          }}
        >
          📁 Batch Upload
        </button>
      </div>

      {/* Single Upload Section */}
      {uploadType === 'single' && (
        <div>
          <form onSubmit={handleSubmit} className="form-card">
            {/* Student Name */}
            <div className="form-group form-group-sm">
              <label>Student name (optional)</label>
              <input
                type="text"
                value={studentName}
                onChange={(e) => setStudentName(e.target.value)}
                placeholder="Student"
              />
            </div>

            {/* Question */}
            <div className="form-group form-group-sm">
              <label>Question (optional)</label>
              <input
                type="text"
                value={question}
                onChange={(e) => setQuestion(e.target.value)}
                placeholder="What is the question?"
              />
            </div>

            {/* Answer Input - Unified (Text or File) */}
            <div className="form-group">
              <label>Student Answer *</label>
              <p style={{ fontSize: '0.9em', color: '#666', marginBottom: '8px' }}>
                📝 Paste text directly OR 🖼️ Upload handwritten image/PDF (will auto-extract with OCR)
              </p>
              
              {/* File Upload */}
              <div style={{ marginBottom: '12px', padding: '12px', backgroundColor: '#f5f5f5', borderRadius: '4px', border: '1px dashed #ccc' }}>
                <label htmlFor="file-input" style={{ cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '8px', color: '#185a9d', fontWeight: 500 }}>
                  📎 Choose File (Image or PDF)
                </label>
                <input
                  id="file-input"
                  ref={fileInputRef}
                  type="file"
                  accept=".jpg,.jpeg,.png,.gif,.bmp,.pdf"
                  onChange={onFileChange}
                  className="file-input"
                  style={{ marginTop: '8px', cursor: 'pointer' }}
                />
                {uploadFile && (
                  <div style={{ marginTop: '8px', padding: '8px', backgroundColor: '#e8f5e9', borderRadius: '4px', color: '#2e7d32', fontSize: '0.9em' }}>
                    ✓ Selected: {uploadFile.name}
                  </div>
                )}
              </div>

              {/* OR Divider */}
              <div style={{ textAlign: 'center', margin: '12px 0', color: '#999', fontWeight: 500 }}>— OR —</div>

              {/* Text Input */}
              <textarea
                value={studentAnswer}
                onChange={handleTextChange}
                rows={6}
                placeholder="Paste the student's answer here... (or upload a file above)"
                style={{
                  width: '100%',
                  padding: '10px',
                  borderRadius: '4px',
                  border: '1px solid #ddd',
                  fontFamily: 'inherit',
                  fontSize: '1em',
                  boxSizing: 'border-box',
                }}
              />
            </div>

            {/* Model Answer */}
            <div className="form-group">
              <label>Model/Expected Answer *</label>
              <textarea
                value={modelAnswer}
                onChange={(e) => setModelAnswer(e.target.value)}
                rows={6}
                placeholder="Enter the correct/expected answer for comparison..."
                style={{
                  width: '100%',
                  padding: '10px',
                  borderRadius: '4px',
                  border: '1px solid #ddd',
                  fontFamily: 'inherit',
                  fontSize: '1em',
                  boxSizing: 'border-box',
                }}
              />
            </div>

            {/* Extracted Text Preview & Edit */}
            {showExtractedText && extractedText && (
              <div style={{ 
                padding: '12px', 
                backgroundColor: '#e3f2fd', 
                borderLeft: '4px solid #2196f3', 
                borderRadius: '4px',
                marginBottom: '12px'
              }}>
                <h4 style={{ margin: '0 0 8px 0', color: '#1565c0' }}>📄 Extracted Text from OCR:</h4>
                <textarea
                  value={studentAnswer}
                  onChange={(e) => setStudentAnswer(e.target.value)}
                  style={{
                    width: '100%',
                    maxHeight: '200px',
                    padding: '8px',
                    borderRadius: '3px',
                    border: '1px solid #2196f3',
                    fontSize: '0.9em',
                    fontFamily: 'inherit',
                    boxSizing: 'border-box',
                    marginBottom: '8px'
                  }}
                />
                <p style={{ margin: '0', fontSize: '0.85em', color: '#555' }}>
                  ✏️ You can edit the extracted text above before final evaluation. Model answer and extracted text will be compared.
                </p>
              </div>
            )}

            {/* Messages */}
            {message && (
              <div className={`form-${isError ? 'error' : 'success'}`}>{message}</div>
            )}

            {/* Buttons */}
            <div style={{ display: 'flex', gap: '8px', marginBottom: '12px' }}>
              <button
                type="submit"
                className="btn-primary"
                disabled={loading || (!uploadFile && !studentAnswer.trim()) || !modelAnswer.trim()}
                style={{ flex: 1 }}
              >
                {loading ? '🔄 Processing...' : '🚀 Process & Evaluate'}
              </button>
              {(studentAnswer || uploadFile || evaluation) && (
                <button
                  type="button"
                  onClick={resetForm}
                  style={{
                    padding: '10px 16px',
                    backgroundColor: '#f44336',
                    color: 'white',
                    border: 'none',
                    borderRadius: '4px',
                    cursor: 'pointer',
                    fontWeight: 500,
                  }}
                >
                  🔄 Reset
                </button>
              )}
            </div>
          </form>

          {/* Evaluation Results */}
          {evaluation && (
            <div style={{
              marginTop: '24px',
              padding: '20px',
              backgroundColor: '#f9f9f9',
              borderRadius: '8px',
              border: '1px solid #ddd',
            }}>
              <h3 style={{ marginTop: 0, color: '#185a9d' }}>📊 Evaluation Results</h3>

              <div style={{
                display: 'flex',
                justifyContent: 'center',
                alignItems: 'center',
                margin: '20px 0',
                padding: '20px',
                backgroundColor: '#fff',
                borderRadius: '8px',
                border: '2px solid #4caf50',
              }}>
                <div style={{ textAlign: 'center' }}>
                  <div style={{
                    fontSize: '3em',
                    fontWeight: 'bold',
                    color: evaluation.score >= 70 ? '#4caf50' : evaluation.score >= 50 ? '#ff9800' : '#f44336',
                  }}>
                    {evaluation.score}
                  </div>
                  <div style={{ fontSize: '1.2em', color: '#666' }}>/ 100</div>
                </div>
              </div>

              {evaluation.matchedConcepts && evaluation.matchedConcepts.length > 0 && (
                <div style={{
                  padding: '12px',
                  backgroundColor: '#e8f5e9',
                  borderLeft: '4px solid #4caf50',
                  borderRadius: '4px',
                  marginBottom: '12px',
                }}>
                  <h4 style={{ margin: '0 0 8px 0', color: '#2e7d32' }}>✓ Matched Concepts:</h4>
                  <ul style={{ margin: '0', paddingLeft: '20px' }}>
                    {evaluation.matchedConcepts.map((concept, i) => (
                      <li key={i} style={{ marginBottom: '4px' }}>{concept}</li>
                    ))}
                  </ul>
                </div>
              )}

              {evaluation.missingConcepts && evaluation.missingConcepts.length > 0 && (
                <div style={{
                  padding: '12px',
                  backgroundColor: '#ffebee',
                  borderLeft: '4px solid #f44336',
                  borderRadius: '4px',
                  marginBottom: '12px',
                }}>
                  <h4 style={{ margin: '0 0 8px 0', color: '#c62828' }}>✗ Missing Concepts:</h4>
                  <ul style={{ margin: '0', paddingLeft: '20px' }}>
                    {evaluation.missingConcepts.map((concept, i) => (
                      <li key={i} style={{ marginBottom: '4px' }}>{concept}</li>
                    ))}
                  </ul>
                </div>
              )}

              {evaluation.feedback && (
                <div style={{
                  padding: '12px',
                  backgroundColor: '#fff3e0',
                  borderLeft: '4px solid #ff9800',
                  borderRadius: '4px',
                }}>
                  <h4 style={{ margin: '0 0 8px 0', color: '#e65100' }}>💬 Feedback:</h4>
                  <p style={{ margin: '0', whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}>
                    {evaluation.feedback}
                  </p>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {/* Batch Upload Section */}
      {uploadType === 'batch' && (
        <BatchUploadAnswers />
      )}
    </div>
  );
};

export default UploadStudentAnswer;
