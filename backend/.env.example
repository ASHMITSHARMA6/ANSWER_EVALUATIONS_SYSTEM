# ============================================================
# TEACHER EVALUATION SYSTEM - GROQ AI POWERED
# ============================================================
# Copy this to .env and fill in your values

# ---- DATABASE ----
# MongoDB connection URI
# Local: mongodb://localhost:27017/tes
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/tes
MONGODB_URI=mongodb://localhost:27017/tes

# ---- AUTHENTICATION ----
# JWT secret for auth tokens (min 32 chars)
JWT_SECRET=a8f3kL9mN2pQ7rT4vX1zB6cD0eF5gH8jK_use_strong_secret

# ---- AI / LLM ----
# Groq API key (required for evaluation, RAG, question generation, and OCR)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# ---- GOOGLE CLOUD VISION OCR (Handwriting Recognition) ----
# Free Tier: 1,000 images/month
# Setup:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or use existing)
#   3. Enable "Cloud Vision API" at:
#      https://console.cloud.google.com/apis/library/vision.googleapis.com
#   4. Go to APIs & Services → Credentials → Create Credentials → API Key
#   5. Copy the key here
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# (Alternative) Use a Service Account JSON file instead of API key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ---- SERVER ----
# Backend server port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ---- VECTOR DATABASE ----
# Local vector DB file location (auto-created)
VECTOR_DB_FILE=./data/vector_db.json

# ---- SEEDING (First-Time Setup) ----
# Default teacher account for npm run seed
SEED_EMAIL=teacher@test.com
SEED_PASSWORD=teacher123

# ============================================================
# NOTES:
#
# 1. GROQ_API_KEY: Required for all AI features (evaluation,
#    question generation, RAG, and OCR vision). Get a free key
#    at https://console.groq.com/keys
#
# 2. MONGODB_URI: Use local MongoDB for development:
#    $ brew services start mongodb-community  (macOS)
#    $ sudo systemctl start mongod            (Linux)
#    $ net start MongoDB                      (Windows)
#
# 3. JWT_SECRET: Generate a strong secret:
#    $ openssl rand -hex 32
#
# 4. Vector DB stores embeddings in FAISS (local JSON).
#    Persisted to disk at VECTOR_DB_FILE location.
#    Data directory is created automatically.
#
# ============================================================
